diff --git a/crates/ui-egui/src/fonts.rs b/crates/ui-egui/src/fonts.rs
index 458e96e..902f376 100644
--- a/crates/ui-egui/src/fonts.rs
+++ b/crates/ui-egui/src/fonts.rs
@@ -60,6 +60,22 @@ pub fn add_web_face(family: &str, bold: bool, italic: bool, data: Vec<u8>) {
     WEB_GENERATION.fetch_add(1, std::sync::atomic::Ordering::Relaxed);
 }
 
+static KEPT: std::sync::RwLock<Vec<String>> = std::sync::RwLock::new(Vec::new());
+
+/// Keeps `families` bound in every font set, used by a workbook or not (a host's font menu draws
+/// each name in its own font). Add their faces with [`add_web_face`].
+pub fn keep_families(families: Vec<String>) {
+    if let Ok(mut k) = KEPT.write() {
+        *k = families;
+    }
+    WEB_GENERATION.fetch_add(1, std::sync::atomic::Ordering::Relaxed);
+}
+
+/// The families [`keep_families`] asked for.
+pub fn kept_families() -> Vec<String> {
+    KEPT.read().map(|k| k.clone()).unwrap_or_default()
+}
+
 /// Changes whenever [`add_web_face`] adds a face, so the app rebinds workbook fonts.
 pub fn web_generation() -> u64 {
     WEB_GENERATION.load(std::sync::atomic::Ordering::Relaxed)
diff --git a/crates/ui-egui/src/theme/font_setup.rs b/crates/ui-egui/src/theme/font_setup.rs
index 079c8c1..01ab0cb 100644
--- a/crates/ui-egui/src/theme/font_setup.rs
+++ b/crates/ui-egui/src/theme/font_setup.rs
@@ -486,7 +486,10 @@ pub fn pinned_font_definitions() -> FontDefinitions {
 /// installed, so cells set in them render with them; the rest fall back to the roles. The bound
 /// families are recorded in [`crate::fonts`] so [`cell_family`] only names a family egui has.
 pub fn font_definitions_with(language: crate::i18n::Language, used: &[String]) -> FontDefinitions {
-    let installed = crate::fonts::installed_among(used).into_iter().map(|family| {
+    // Families the host keeps bound whatever the workbook uses (e.g. font-menu previews).
+    let mut used = used.to_vec();
+    used.extend(crate::fonts::kept_families());
+    let installed = crate::fonts::installed_among(&used).into_iter().map(|family| {
         let faces = crate::fonts::faces_of(&family);
         (family, faces)
     });
