+
+/// Runs `f` with open-ended ranges (`A3:C`) printed in full (`A3:C1048576`), for writing files
+/// that Excel reads.
+pub fn with_full_rows<R>(f: impl FnOnce() -> R) -> R {
+    let before = FULL_ROWS.with(|c| c.replace(true));
+    let out = f();
+    FULL_ROWS.with(|c| c.set(before));
+    out
+}
